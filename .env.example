# Server Configuration
SERVER_ADDR=0.0.0.0:8080
CONFIG_DB_PATH=config/private-storage.db

# Authentication
# Defaults: admin / admin@123
AUTH_USERNAME=admin
AUTH_PASSWORD=admin@123
ADMIN_API_KEY=

# App Secret (used for credential encryption)
# Set this in production.
APP_SECRET=

# Optional HTTPS (enable only when both are set)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Built-in SFTP (can also be changed from web settings)
SFTP_ENABLED=false
SFTP_ADDR=0.0.0.0:2022
SFTP_USER=
SFTP_PASSWORD=

# Optional initial S3 connection bootstrap (first run only)
# If S3_BUCKET is empty, you can add connections from the UI later.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
