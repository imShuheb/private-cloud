# Domain pointing at this server (a free DuckDNS name such as mycloud.duckdns.org works).
# Caddy gets the HTTPS certificate for it automatically.
DOMAIN=

# Owner account, created on first start. The password is required: the server refuses
# to start with the default one. Later changes are made in Settings -> Users & Access.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Encrypts stored S3 keys. Generate with: openssl rand -hex 32
# Keep it safe: without it the saved connections cannot be decrypted.
APP_SECRET=

# Optional: first S3 connection (Cloudflare R2, Backblaze B2, AWS ...). Can also be added in the UI.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true
