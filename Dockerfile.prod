FROM alpine:latest

ARG TARGETARCH

WORKDIR /app

RUN apk add --no-cache ca-certificates

# Copy the pre-built binary for the correct architecture
# This single file now contains the backend AND the frontend!
COPY bin/linux-${TARGETARCH}/main .

# Standard Environment Variables
ENV SERVER_ADDR=0.0.0.0:8080
ENV AUTH_USERNAME=admin
ENV AUTH_PASSWORD=admin@123
ENV ADMIN_API_KEY=
ENV CONFIG_DB_PATH=config/private-storage.db
ENV SFTP_ENABLED=false
ENV SFTP_ADDR=0.0.0.0:2022
ENV SFTP_USER=
ENV SFTP_PASSWORD=
ENV TLS_CERT_FILE=
ENV TLS_KEY_FILE=
ENV S3_BUCKET=
ENV S3_REGION=
ENV S3_ENDPOINT=
ENV S3_ACCESS_KEY=
ENV S3_SECRET_KEY=
ENV S3_USE_PATH_STYLE=false

EXPOSE 8080
EXPOSE 2022

CMD ["./main"]
